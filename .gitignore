node_modules/
dist/
.DS_Store
*.log

# Local tool/harness configuration (e.g. dev-server launch config for
# the Claude Code browser preview) - not part of the application.
.claude/

# Environment/secret files - never committed. Only the value-free
# templates (.env.example, .env.<name>.example) are.
.env
.env.*
!.env.example
!.env.*.example

# Local deployment CLI state (project links, not credentials, but per-person).
.vercel/
.fly/
.railway/
