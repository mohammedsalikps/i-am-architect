# Settings for the REAL-infrastructure tests - TEMPLATE ONLY, no real values.
#
# Copy to backend/.env.integration (gitignored - never commit it) and fill in.
# Used only by (from backend/):
#   npm run test:integration   real Supabase project, backend code running locally
#   npm run test:deployed      the deployed backend and frontend
# Neither is part of `npm run verify`. NEVER point these at a production project:
# they create and delete (their own) test data.

# --- The development/staging Supabase project (Project Settings -> API) ---
SUPABASE_URL=
# The anon / publishable key. Never the service-role / secret key (refused).
SUPABASE_ANON_KEY=
# The project ref - the "abcdefgh" in https://abcdefgh.supabase.co. Must match
# SUPABASE_URL: a guard against testing the wrong project.
INTEGRATION_PROJECT_REF=
# Must be exactly "yes": you confirm the project above is NOT production.
INTEGRATION_CONFIRM_NON_PRODUCTION=

# --- Two confirmed test accounts in that project ---
# Authentication -> Users -> Add user -> Create new user, with "Auto Confirm User".
# Use addresses you control; use passwords you use nowhere else.
INTEGRATION_USER_A_EMAIL=
INTEGRATION_USER_A_PASSWORD=
INTEGRATION_USER_B_EMAIL=
INTEGRATION_USER_B_PASSWORD=

# --- npm run test:deployed only ---
# The deployed backend's https:// URL, and the deployed frontend's https:// URL.
DEPLOYED_BACKEND_URL=
DEPLOYED_FRONTEND_URL=
# "yes" to send ONE small real AI request through the deployed backend
# (it uses whichever AI provider and key are configured on the backend
# host - AI_PROVIDER=openai or gemini - a few cents at most, or free on
# Gemini's free tier).
DEPLOYED_RUN_AI=
