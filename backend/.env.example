# Example environment file for the i am Architect AI proxy backend.
#
# This is a TEMPLATE ONLY - it contains no real credentials. Copy it to
# `.env` (already gitignored by the root .gitignore's `.env`/`.env.*`
# rules, which apply repo-wide) and fill in real values. Never commit a
# real `.env` file. Run with: node --env-file=.env src/server.ts

# Required. Your real OpenAI API key. Get one at
# https://platform.openai.com/api-keys - this is the ONLY place in the
# whole project this value is ever read (see src/server.ts). It never
# reaches the frontend, Vite, or any browser-shipped code.
OPENAI_API_KEY=your-openai-api-key-here

# Optional. Port this server listens on. Defaults to 8787 if unset.
PORT=8787

# Optional. The single origin allowed to call this server
# (Access-Control-Allow-Origin) - set this to wherever the Vite dev
# server (or a future production frontend) is actually served from.
# Defaults to http://localhost:5173 (Vite's default dev port) if unset.
FRONTEND_ORIGIN=http://localhost:5173
