# Example environment file for the i am Architect backend.
#
# This is a TEMPLATE ONLY - it contains no real credentials. Copy it to
# `.env` (already gitignored by the root .gitignore's `.env`/`.env.*`
# rules, which apply repo-wide) and fill in real values. Never commit a
# real `.env` file. Run with: node --env-file=.env src/server.ts
#
# On a host (Fly.io) there is no .env file: the same variables are set as
# the host's secrets - see DEPLOYMENT.md "Hosted deployment, in order".

# Which AI provider this server uses - "openai" or "gemini". Defaults to
# "openai" if unset. Only the CHOSEN provider's key below is required or
# even read; the other is ignored. See src/engine/ai/providers/.
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini (the default staging choice - no paid
# OpenAI key needed). Your real Gemini API key, free to create at
# https://aistudio.google.com/apikey - it is read only by this server
# (src/server.ts -> src/config.ts). It never reaches the frontend, Vite,
# or any browser-shipped code.
GEMINI_API_KEY=your-gemini-api-key-here

# Required when AI_PROVIDER=openai instead. Your real OpenAI API key. Get
# one at https://platform.openai.com/api-keys - it is read only by this
# server (src/server.ts -> src/config.ts). It never reaches the frontend,
# Vite, or any browser-shipped code.
# OPENAI_API_KEY=your-openai-api-key-here

# Optional. Port this server listens on. Defaults to 8787 if unset.
PORT=8787

# The browser origins allowed to call this server (CORS): a comma-separated
# list of EXACT origins - scheme://host[:port], no path, no trailing slash.
# Any other origin gets 403. Wildcards are refused, and every origin other
# than localhost must be https://. Locally, the Vite dev server (the default
# when unset); on a host, the deployed frontend's exact production URL, e.g.
#   FRONTEND_ORIGIN=https://iarchitect-staging.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Set by the Dockerfile (and fly.toml) on a host: NODE_ENV=production, which
# refuses LOCAL_AUTH=memory. Leave unset locally.
# NODE_ENV=production

# Accounts and saved projects - choose ONE of the two options below.
# The server refuses to start until one is chosen.
#
# (a) Supabase Auth + PostgreSQL. Both values come from the Supabase
#     dashboard (Project Settings -> API): the project URL, and the anon /
#     publishable key. NEVER put the service-role / secret key here - the
#     server refuses to start with one; it relies on Row Level Security.
#     Create the database first by running BOTH migrations in
#     supabase/migrations/, in filename order:
#       20260910000000_create_projects.sql
#       20260911000000_projects_document_check.sql
SUPABASE_URL=
SUPABASE_ANON_KEY=

# (b) Local development without Supabase: accounts and projects kept in
#     this server's memory, gone when it stops. Uncomment to use. Refused
#     when NODE_ENV=production.
# LOCAL_AUTH=memory
